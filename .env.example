# Environment Variables untuk SILAPOR-KU
# Salin file ini menjadi .env.local (atau .env): cp .env.example .env.local

# PostgreSQL Connection String (Neon Database) - gunakan string "pooled" dari Neon Console
# Format: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:npg_password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Opsional: koneksi langsung (non-pooler) khusus untuk drizzle-kit (generate/push/studio).
# Bila kosong, drizzle-kit memakai DATABASE_URL.
DIRECT_URL="postgresql://neondb_owner:npg_password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Kunci penandatangan sesi aparatur. Minimal 32 karakter acak, jangan pernah di-commit.
# Buat dengan: openssl rand -base64 32
SESSION_SECRET="ganti_dengan_string_acak_minimal_32_karakter"

# Opsional, hanya dipakai `npm run db:seed`. Bila kosong, kata sandi acak dibuat dan dicetak sekali.
# SEED_ADMIN_PASSWORD=""
# SEED_WALI_PASSWORD=""
# Hanya untuk database development (jangan diaktifkan di produksi):
# SEED_DEMO=1            -> tambah 9 laporan dummy
# SEED_RESET_PASSWORD=1  -> timpa kata sandi akun yang sudah ada (butuh kedua SEED_*_PASSWORD)

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
